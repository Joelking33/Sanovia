// ============================================================
// SANOovIA - Schema de base de données
// Production: PostgreSQL (Vercel + Neon)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL") // Pour les migrations (contourne le pool)
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  phone         String?
  language      String    @default("fr")
  authProvider  String    @default("email")
  googleId      String?   @unique
  role          String    @default("user")
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  conversations Conversation[]
  resetTokens   PasswordResetToken[]
}

// ============================================================
// TOKENS DE RÉINITIALISATION DE MOT DE PASSE
// ============================================================

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  isUsed     Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================================
// CONVERSATIONS
// ============================================================

model Conversation {
  id          String    @id @default(cuid())
  userId      String
  title       String    @default("Nouvelle conversation")
  category    String    @default("general")
  language    String    @default("fr")
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

// ============================================================
// MESSAGES
// ============================================================

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  language       String   @default("fr")
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ============================================================
// CONSEILS DE SANTÉ
// ============================================================

model HealthTip {
  id          String   @id @default(cuid())
  category    String
  subcategory String?
  title       String
  content     String
  titleBa     String?
  contentBa   String?
  titleDy     String?
  contentDy   String?
  titleBq     String?
  contentBq     String?
  severity    String   @default("info")
  tags        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}